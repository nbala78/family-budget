# Neon Postgres: pooled connection string, and the direct one for migrations.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Keep a safe copy: if this key is lost, encrypted fields cannot be read.
FIELD_ENCRYPTION_KEY=""

# Shared secret Vercel Cron sends to /api/cron/fx. Generate with: openssl rand -hex 24
CRON_SECRET=""
